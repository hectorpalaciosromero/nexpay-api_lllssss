{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "🔌 Circuit Breaker State",
      "type": "state-timeline",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"walletService\"}",
          "legendFormat": "{{name}} → {{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "❌ Failed Payments / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(payment_transactions_total{status=\"FAILED\"}[1m])",
          "legendFormat": "Failed Payments",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "custom": { "fillOpacity": 25 } }
      }
    },
    {
      "title": "📬 SQS DLQ Depth",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sqs_dlq_messages_visible",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "title": "🔄 Circuit Breaker Calls",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(resilience4j_circuitbreaker_calls_seconds_count[5m])",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "🔁 Retry Attempts / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(resilience4j_retry_calls_total[1m])",
          "legendFormat": "{{name}} - {{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "⚠️ Exception Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (application, uri)",
          "legendFormat": "{{application}} {{uri}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["nexpay", "errors"],
  "time": { "from": "now-3h", "to": "now" },
  "title": "NexPay — Error Tracking",
  "uid": "nexpay-errors",
  "version": 1
}
